# Copy to .env for local Docker Compose runs. Do not commit real secrets.

APP_PORT=8080
APP_BIND_HOST=0.0.0.0
# Admin is intentionally served by a separate nginx service/port from the
# consumer site. Keep it internal or protected in real deployments.
ADMIN_PORT=8081
ADMIN_BIND_HOST=127.0.0.1

POSTGRES_DB=fengshui
POSTGRES_USER=fengshui
# Compose interpolates this value into DATABASE_URL. Use a long URL-safe value
# (letters, numbers, hyphen and underscore) for this single-VM Demo.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
# Stable server-side admin identity recorded on drafts, edits and publications.
ADMIN_ACTOR_ID=local-admin-editor
SEED_PROFESSIONAL_KNOWLEDGE=false
# Fixed single-admin console login. The admin web console signs in with these
# credentials and receives an HttpOnly session cookie. One admin both edits and
# publishes; there is no separate reviewer role.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
KNOWLEDGE_MCP_TOKEN=replace-with-a-long-random-internal-reader-token
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional. Blank values fall back to the product default vision model.
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# Optional report generation timeout in milliseconds. Allowed range: 30000-600000.
REPORT_GENERATION_TIMEOUT_MS=480000
# Optional executable used for server-side chart PDF export. The production
# Docker image provides /usr/bin/chromium; leave blank for safe local discovery.
PDF_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# Local development can auto-publish one clearly labeled demo rule profile.
# Production never auto-seeds it; set to false locally if you want an empty expert-rule store.
DEMO_SEED_BAZI_RULE_PROFILE=false

NODE_ENV=production
STORAGE_DRIVER=postgres
HOST=0.0.0.0
PORT=3001
WENZHEN_EVIDENCE_PATH=/app/.data/evidence/wenzhen
# Professional reasoning may make one repair call when the first strict JSON response is invalid.
PROFESSIONAL_REASONING_TIMEOUT_MS=180000
