# Local-only Demo template. Copy to .env only for local development.
# Do not commit .env, and do not paste production credentials here.

NODE_ENV=development
STORAGE_DRIVER=file
HOST=127.0.0.1
PORT=3001

# Browser app ports used by pnpm dev:demo.
WEB_HOST=127.0.0.1
WEB_PORT=4173
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4174

# Admin backend credentials. Leave blank until you need the admin console flows.
# Use long random local-only values; do not reuse production tokens.
ADMIN_API_TOKEN=
ADMIN_ACTOR_ID=local-admin-editor
SEED_PROFESSIONAL_KNOWLEDGE=true
# Fixed single-admin console login. When left blank, pnpm dev:demo uses
# admin / admin123 for local demonstration only.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# DeepSeek model access. Leave blank for chart, storage, and knowledge tests.
# Rotate any key that has been pasted into chat before a formal investor demo.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=
# Optional report generation timeout in milliseconds. Allowed range: 30000-600000.
REPORT_GENERATION_TIMEOUT_MS=480000
# Optional path to Chrome/Chromium for server-side chart PDF export. Leave blank
# to discover supported standard installation paths without logging the path.
PDF_BROWSER_EXECUTABLE_PATH=

# Read-only internal knowledge MCP credential. Leave blank unless you run the MCP bridge.
KNOWLEDGE_MCP_TOKEN=
KNOWLEDGE_MCP_URL=

# Local rule seed: true gives first-run demos an auditable example rule profile.
DEMO_SEED_BAZI_RULE_PROFILE=true

# Optional private evidence path for locally captured WenZhen screenshots.
WENZHEN_EVIDENCE_PATH=.data/evidence/wenzhen

# Optional file-store override. Defaults to .data/residences.json.
RESIDENCES_FILE_PATH=.data/residences.json
# Professional reasoning may make one repair call when the first strict JSON response is invalid.
PROFESSIONAL_REASONING_TIMEOUT_MS=180000
